// Pour Vim
// -------------------------------------
// T-D gives :
COMB(TD_COLN, KC_DOT, LCTL_T(KC_T), RALT_T(KC_D))
// N-H gives /
// COMB(NH_SLSH, FR_SLSH, RCTL_T(KC_N), RALT_T(KC_H))
// S-C gives ^
// COMB(SC_CIRC, ALGR(FR_CCED), LSFT_T(KC_S), KC_C)

// S-C gives 0 (line start)
COMB(SC_CIRC, FR_0, LSFT_T(KC_S), KC_C)
// N-H gives ^
COMB(NH_CIRC, ALGR(FR_CCED), RCTL_T(KC_N), RALT_T(KC_H))
// e et - gives $
// COMB(EMINS_DLR, FR_DLR, RSFT_T(KC_E), FR_MINS)
// e et , give $
COMB(ECOMM_DLR, FR_DLR, RSFT_T(KC_E), FR_COMM)

// T-G gives =
// COMB(TG_EQL, FR_EQL, LCTL_T(KC_T), KC_G)
// N-M gives ;
COMB(NM_SCLN, FR_SCLN, RCTL_T(KC_N), FR_M)


// Texte
// ----------------------------------------
// QA donne qu en mode Colemak-fr
SUBS(QA_QU, "qu", FR_Q, LGUI_T(FR_A))

// QZ donne qu en mode Colemak-fr
SUBS(QZ_QU, "qu", FR_Q, FR_Z)

